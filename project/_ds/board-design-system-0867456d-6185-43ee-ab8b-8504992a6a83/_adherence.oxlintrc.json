{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/dataviz/**",
              "components/event/**",
              "components/layout/**",
              "ui_kits/event_app/**",
              "ui_kits/sponsorship_deck/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Ambit))/i]",
        "message": "Font not provided by the design system. Available: Ambit."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|key|ref|className|style|children)$/]",
        "message": "<BarDatum> doesn't accept that prop. Declared props: label, value, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|onLight|href|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, onLight, href, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|price|pricePrefix|media|interactive|onLight|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, eyebrow, price, pricePrefix, media, interactive, onLight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:target|size|color|showSeconds|key|ref|className|style|children)$/]",
        "message": "<Countdown> doesn't accept that prop. Declared props: target, size, color, showSeconds."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:light|dark|aqua)$/]",
        "message": "<Countdown> color must be one of 'light' | 'dark' | 'aqua'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|color|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: number, color, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|accent|children|key|ref|className|style|children)$/]",
        "message": "<FeatureBlock> doesn't accept that prop. Declared props: title, accent, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:marker|label|onLight|key|ref|className|style|children)$/]",
        "message": "<FooterRule> doesn't accept that prop. Declared props: marker, label, onLight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|variant|size|iconSize|onLight|href|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, label, variant, size, iconSize, onLight, href, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|ghost|outline)$/]",
        "message": "<IconButton> variant must be one of 'solid' | 'ghost' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|helper|error|onLight|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, helper, error, onLight."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<LineDatum> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|cta|sticky|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: links, cta, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='PieDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|key|ref|className|style|children)$/]",
        "message": "<PieDatum> doesn't accept that prop. Declared props: label, value, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|prefix|tone|size|key|ref|className|style|children)$/]",
        "message": "<PriceTag> doesn't accept that prop. Declared props: amount, prefix, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|blue|outline|dark)$/]",
        "message": "<PriceTag> tone must be one of 'teal' | 'blue' | 'outline' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<PriceTag> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|theme|maxWidth|py|innerStyle|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: eyebrow, title, theme, maxWidth, py, innerStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Section> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|title|stage|kind|saved|onToggle|onLight|key|ref|className|style|children)$/]",
        "message": "<SessionRow> doesn't accept that prop. Declared props: time, title, stage, kind, saved, onToggle, onLight."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionRow'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:Keynote|Session|Hospitality|Interview|Meetings|Social)$/]",
        "message": "<SessionRow> kind must be one of 'Keynote' | 'Session' | 'Hospitality' | 'Interview' | 'Meetings' | 'Social'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:tagline|columns|legal|venue|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: tagline, columns, legal, venue."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeakerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|company|photo|tag|onLight|key|ref|className|style|children)$/]",
        "message": "<SpeakerCard> doesn't accept that prop. Declared props: name, role, company, photo, tag, onLight."
      },
      {
        "selector": "JSXOpeningElement[name.name='SponsorWall'] > JSXAttribute > JSXIdentifier[name!=/^(?:tiers|onLight|key|ref|className|style|children)$/]",
        "message": "<SponsorWall> doesn't accept that prop. Declared props: tiers, onLight."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarLevel'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|total|band|size|color|key|ref|className|style|children)$/]",
        "message": "<StarLevel> doesn't accept that prop. Declared props: level, total, band, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|align|color|size|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, align, color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Stat> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:light|dark|aqua|blue)$/]",
        "message": "<Stat> color must be one of 'light' | 'dark' | 'aqua' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Stat> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|prefix|suffix|label|decimals|duration|size|color|align|key|ref|className|style|children)$/]",
        "message": "<StatCounter> doesn't accept that prop. Declared props: value, prefix, suffix, label, decimals, duration, size, color, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCounter'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:light|dark|aqua|blue)$/]",
        "message": "<StatCounter> color must be one of 'light' | 'dark' | 'aqua' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCounter'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatCounter> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|onLight|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant, onLight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|blue|ghost)$/]",
        "message": "<Tag> variant must be one of 'outline' | 'solid' | 'blue' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|variant|tagline|as|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, color, variant, tagline, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:wordmark|icon)$/]",
        "message": "<Wordmark> variant must be one of 'wordmark' | 'icon'."
      }
    ]
  },
