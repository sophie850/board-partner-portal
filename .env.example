# ============================================================
# BOARD Partner Portal — environment
# Copy to .env.local and fill in. Never commit real values.
# ============================================================

# --- Supabase (server-side) ---------------------------------
# The secret key grants full database access, bypassing row-level
# security. It is read only in server code. Never prefix it with
# NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# --- Supabase (browser) -------------------------------------
# Safe to expose. Used by the browser once magic-link auth lands;
# it is subject to row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Interim access gate ------------------------------------
# A single shared passphrase in front of the whole site, standing in
# for authentication until magic links are built. Leave blank to
# disable the gate and leave the site fully open.
PORTAL_PASSPHRASE=

# --- Outbound webhooks --------------------------------------
# Supplier webhook secrets live in the database, never here, and are
# never sent to a client. This only toggles real delivery on/off.
WEBHOOKS_ENABLED=false
